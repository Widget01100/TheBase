// src/utils/export/exportUtils.ts
// Export utilities for The Base
// Handles CSV, JSON, and PDF exports of transactions and other data

import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';

export interface ExportOptions {
  filename?: string;
  title?: string;
  subtitle?: string;
  includeHeaders?: boolean;
}

export interface ExportableTransaction {
  id: string;
  description: string;
  category: string;
  type: 'income' | 'expense' | 'investment' | 'savings';
  date: string;
  time?: string;
  amount: number;
  merchant?: string;
  tags?: string[];
}

// ─────────────────────────────────────────────────────────────
// CSV Export
// ─────────────────────────────────────────────────────────────

export function exportToCSV(
  data: ExportableTransaction[],
  options: ExportOptions = {}
): void {
  const {
    filename = `thebase-transactions-${formatDateForFilename(new Date())}.csv`,
    includeHeaders = true,
  } = options;

  const headers = [
    'Date',
    'Time',
    'Description',
    'Category',
    'Type',
    'Merchant',
    'Amount (KES)',
    'Tags',
  ];

  const rows = data.map((t) => [
    t.date,
    t.time || '',
    escapeCSV(t.description),
    t.category,
    t.type,
    escapeCSV(t.merchant || ''),
    t.amount.toString(),
    (t.tags || []).join(';'),
  ]);

  const csvContent = [
    includeHeaders ? headers.join(',') : '',
    ...rows.map((row) => row.join(',')),
  ]
    .filter(Boolean)
    .join('\n');

  downloadFile(csvContent, filename, 'text/csv;charset=utf-8;');
}

function escapeCSV(value: string): string {
  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
    return `"${value.replace(/"/g, '""')}"`;
  }
  return value;
}

// ─────────────────────────────────────────────────────────────
// JSON Export
// ─────────────────────────────────────────────────────────────

export function exportToJSON(
  data: ExportableTransaction[],
  options: ExportOptions = {}
): void {
  const {
    filename = `thebase-transactions-${formatDateForFilename(new Date())}.json`,
    title = 'The Base — Transactions Export',
  } = options;

  const payload = {
    export_info: {
      exported_at: new Date().toISOString(),
      exported_by: 'The Base v2.0.0',
      record_count: data.length,
      title,
    },
    transactions: data,
  };

  const jsonContent = JSON.stringify(payload, null, 2);
  downloadFile(jsonContent, filename, 'application/json');
}

// ─────────────────────────────────────────────────────────────
// PDF Export
// ─────────────────────────────────────────────────────────────

export function exportToPDF(
  data: ExportableTransaction[],
  options: ExportOptions = {}
): void {
  const {
    filename = `thebase-transactions-${formatDateForFilename(new Date())}.pdf`,
    title = 'The Base — Transaction Report',
    subtitle = '',
  } = options;

  const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });

  // ─── Header: branded bar ───
  const pageWidth = doc.internal.pageSize.getWidth();

  // Blue brand bar
  doc.setFillColor(14, 165, 233); // primary-600
  doc.rect(0, 0, pageWidth, 60, 'F');

  // Brand text
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(20);
  doc.setFont('helvetica', 'bold');
  doc.text('The Base', 40, 38);

  doc.setFontSize(10);
  doc.setFont('helvetica', 'normal');
  doc.text('Financial Command Center', 40, 52);

  // Date top-right
  doc.setFontSize(10);
  const dateStr = new Date().toLocaleDateString('en-KE', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
  doc.text(dateStr, pageWidth - 40, 38, { align: 'right' });

  // ─── Title section ───
  doc.setTextColor(30, 41, 59);
  doc.setFontSize(16);
  doc.setFont('helvetica', 'bold');
  doc.text(title, 40, 95);

  if (subtitle) {
    doc.setFontSize(10);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(100, 116, 139);
    doc.text(subtitle, 40, 112);
  }

  // ─── Summary stats ───
  const totalIncome = data
    .filter((t) => t.type === 'income')
    .reduce((sum, t) => sum + Math.abs(t.amount), 0);
  const totalExpenses = data
    .filter((t) => t.type === 'expense')
    .reduce((sum, t) => sum + Math.abs(t.amount), 0);
  const totalInvestments = data
    .filter((t) => t.type === 'investment')
    .reduce((sum, t) => sum + Math.abs(t.amount), 0);
  const netFlow = totalIncome - totalExpenses - totalInvestments;

  const summaryY = 140;
  doc.setFontSize(9);
  doc.setTextColor(100, 116, 139);

  doc.text('Total Income:', 40, summaryY);
  doc.text('Total Expenses:', 200, summaryY);
  doc.text('Total Investments:', 400, summaryY);
  doc.text('Net Cashflow:', 600, summaryY);

  doc.setFontSize(14);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(16, 185, 129);
  doc.text(`KSh ${totalIncome.toLocaleString()}`, 40, summaryY + 18);

  doc.setTextColor(239, 68, 68);
  doc.text(`KSh ${totalExpenses.toLocaleString()}`, 200, summaryY + 18);

  doc.setTextColor(139, 92, 246);
  doc.text(`KSh ${totalInvestments.toLocaleString()}`, 400, summaryY + 18);

  doc.setTextColor(netFlow >= 0 ? 16 : 239, netFlow >= 0 ? 185 : 68, netFlow >= 0 ? 129 : 68);
  doc.text(`KSh ${netFlow.toLocaleString()}`, 600, summaryY + 18);

  // ─── Table ───
  autoTable(doc, {
    startY: summaryY + 45,
    head: [['Date', 'Time', 'Description', 'Category', 'Type', 'Amount (KES)']],
    body: data.map((t) => [
      t.date,
      t.time || '-',
      t.description,
      t.category,
      t.type.charAt(0).toUpperCase() + t.type.slice(1),
      `${t.amount >= 0 ? '+' : '-'}${Math.abs(t.amount).toLocaleString()}`,
    ]),
    theme: 'grid',
    headStyles: {
      fillColor: [14, 165, 233],
      textColor: [255, 255, 255],
      fontStyle: 'bold',
      fontSize: 10,
    },
    bodyStyles: {
      fontSize: 9,
      textColor: [30, 41, 59],
    },
    alternateRowStyles: {
      fillColor: [248, 250, 252],
    },
    columnStyles: {
      0: { cellWidth: 80 },
      1: { cellWidth: 60 },
      2: { cellWidth: 220 },
      3: { cellWidth: 100 },
      4: { cellWidth: 80 },
      5: { cellWidth: 100, halign: 'right' },
    },
    didParseCell: (data) => {
      // Color amount column: green for positive, red for negative
      if (data.section === 'body' && data.column.index === 5) {
        const value = String(data.cell.raw);
        if (value.startsWith('+')) {
          data.cell.styles.textColor = [16, 185, 129];
          data.cell.styles.fontStyle = 'bold';
        } else {
          data.cell.styles.textColor = [239, 68, 68];
          data.cell.styles.fontStyle = 'bold';
        }
      }
    },
    margin: { left: 40, right: 40 },
  });

  // ─── Footer ───
  const pageCount = (doc as any).internal.getNumberOfPages();
  for (let i = 1; i <= pageCount; i++) {
    doc.setPage(i);
    const pageHeight = doc.internal.pageSize.getHeight();

    doc.setFontSize(8);
    doc.setTextColor(148, 163, 184);
    doc.text(
      `The Base — Made with ❤️ for Kenya  |  Generated on ${new Date().toLocaleString()}`,
      40,
      pageHeight - 20
    );
    doc.text(
      `Page ${i} of ${pageCount}`,
      pageWidth - 40,
      pageHeight - 20,
      { align: 'right' }
    );
  }

  doc.save(filename);
}

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────

function downloadFile(
  content: string,
  filename: string,
  mimeType: string
): void {
  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

function formatDateForFilename(date: Date): string {
  return date.toISOString().split('T')[0];
}
